          "auth": {
            "authType": "none",
            "authActive": true
          },
          "body": {
            "contentType": "application/json",
            "body": "{\n  \"email\": \"<<authEmail>>\",\n  \"password\": \"<<authPassword>>\"\n}"
          }
        }
