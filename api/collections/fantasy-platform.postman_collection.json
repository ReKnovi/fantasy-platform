    {
      "name": "User Roles (admin)",
      "item": [
        {
          "name": "Promote/Change User Role (super_admin only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"scorer_admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/:id/role",
              "host": ["{{baseUrl}}"],
              "path": ["users", ":id", "role"],
              "variable": [
                {
                  "key": "id",
                  "value": "REPLACE_WITH_TARGET_USER_UUID"
                }
              ]
            },
            "description": "Requires the signed-in caller to already be super_admin (the very first one still has to be set via a direct DB UPDATE — see the module notes). :id is the target user's users.id UUID, not their Firebase uid. role must be one of: user, scorer_admin, roster_admin, super_admin. Trying to change your own role should 400 with 'Cannot change your own role'."
          },
          "response": []
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{firebaseIdToken}}",
            "type": "string"
          }
        ]
      }
    },
