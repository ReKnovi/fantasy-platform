    {
      "name": "Squad Selection",
      "item": [
        {
          "name": "Get My Lineup For Gameweek",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/squad-selection?gameweekId=1",
              "host": ["{{baseUrl}}"],
              "path": ["squad-selection"],
              "query": [
                {
                  "key": "gameweekId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Set Lineup For Gameweek",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gameweekId\": 1,\n  \"entries\": [\n    { \"playerId\": 1, \"isStarting\": true, \"isCaptain\": true },\n    { \"playerId\": 2, \"isStarting\": true, \"isViceCaptain\": true },\n    { \"playerId\": 3, \"isStarting\": true },\n    { \"playerId\": 4, \"isStarting\": true },\n    { \"playerId\": 5, \"isStarting\": true },\n    { \"playerId\": 6, \"isStarting\": true },\n    { \"playerId\": 7, \"isStarting\": true },\n    { \"playerId\": 8, \"isStarting\": true },\n    { \"playerId\": 9, \"isStarting\": true },\n    { \"playerId\": 10, \"isStarting\": true },\n    { \"playerId\": 11, \"isStarting\": true },\n    { \"playerId\": 12, \"isStarting\": false, \"benchOrder\": 1 },\n    { \"playerId\": 13, \"isStarting\": false, \"benchOrder\": 2 },\n    { \"playerId\": 14, \"isStarting\": false, \"benchOrder\": 3 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/squad-selection",
              "host": ["{{baseUrl}}"],
              "path": ["squad-selection"]
            },
            "description": "The 14 playerIds here must exactly match your own squad from GET /squad — swap these placeholders for your actual squad's player ids first, or this will 400 with 'Player id(s) not in your squad'. Also needs a gameweekId whose deadline_time hasn't passed yet (check GET /gameweeks/current) or you'll get the 'Gameweek is locked' error instead.\n\nGood negative tests to try: move isCaptain onto a bench player (expects 'Captain and vice-captain must both be in the starting XI'), duplicate a benchOrder value (expects the benchOrder uniqueness error), or drop one entry so only 13 are submitted (expects the exactly-14 error)."
          },
          "response": []
        }
      ],
