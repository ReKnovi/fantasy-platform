  "item": [
    {
      "name": "Dev Auth",
      "item": [
        {
          "name": "Get Firebase ID Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"token returned\", function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.idToken).to.be.a(\"string\");",
                  "  pm.collectionVariables.set(\"firebaseIdToken\", data.idToken);",
                  "  pm.collectionVariables.set(\"playerId\", pm.collectionVariables.get(\"playerId\") || \"1\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/dev/auth/id-token",
              "host": ["{{baseUrl}}"],
              "path": ["dev", "auth", "id-token"]
            },
            "description": "Local-only helper. Creates/signs in a Firebase Auth emulator user and stores the returned ID token in firebaseIdToken."
          },
          "response": []
        }
      ]
    },
