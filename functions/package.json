{
  "name": "functions",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "test": "node --test",
    "ci": "npm run lint && npm run test && npm run build",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "dev": "npm run build && firebase emulators:start --inspect-functions --only functions",
    "serve:http": "npm run build && node lib/server.js",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "start:http": "node lib/server.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^7.0.2"
  },
  "private": true
}
